# Copy this file to ".env" (or ".env.local") and adjust. Never put secrets here:
# everything starting with VITE_ is visible to anyone who opens the website.

# Address of the backend API, without a trailing slash and without "/api".
# The backend's CLIENT_ORIGIN setting must include the address this website runs on
# (Vite's default is http://localhost:5173), otherwise the browser blocks the requests.
VITE_API_BASE_URL=http://localhost:5000

# Account Management Backend (login, refresh and logout).
VITE_ACCOUNT_API_BASE_URL=http://localhost:5100/api

# Optional. The school code sent with every login. Leave empty when the backend has
# DEFAULT_SCHOOL_CODE set (single-school installations).
VITE_SCHOOL_CODE=
